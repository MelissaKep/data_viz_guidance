.tag-bar {
  background: #f8f9fa; /* Light grey background */
  border-bottom: 1px solid #ddd;
  padding: 10px 0;
  text-align: center;
}

.tag-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: inline-flex;
  gap: 15px; /* Spacing between tags */
}

.tag-label {
  font-weight: bold;
  margin-right: 10px;
  color: #666;
  font-size: 0.9rem;
}

.tag-item {
  text-decoration: none;
  color: #007bff;
  font-size: 0.9rem;
  font-weight: 500;
}

.tag-item:hover {
  text-decoration: underline;
  color: #0056b3;
}
